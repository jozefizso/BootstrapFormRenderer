{
	"name": "jozefizso/bootstrap-form-renderer-integration",
	"description": "Compatibility application for BootstrapFormRenderer dependency matrices",
	"type": "project",
	"license": "BSD-3-Clause",
	"repositories": [
		{
			"type": "path",
			"url": "../..",
			"options": {
				"symlink": true,
				"versions": {
					"jozefizso/bootstrap-form-renderer": "dev-main"
				}
			}
		}
	],
	"require": {
		"php": ">=7.1 <8.4",
		"jozefizso/bootstrap-form-renderer": "dev-main",
		"latte/latte": "^2.6",
		"nette/application": "^3.0.8 <3.2",
		"nette/forms": "^3.0.7 <3.2",
		"nette/utils": "^3.1 || ~4.0.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
